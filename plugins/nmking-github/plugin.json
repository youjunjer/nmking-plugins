{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "nmking-github",
  "version": "0.2.0",
  "description": "Independently installable GitHub MCP plugin with bundled server configuration and user-owned onboarding.",
  "author": {
    "name": "小霸王有限公司 / NMKING",
    "email": "nmkingtw@gmail.com",
    "url": "https://ai.nmking.io"
  },
  "homepage": "https://ai.nmking.io/connect#github",
  "repository": "https://github.com/youjunjer/nmking-plugins",
  "keywords": [
    "nmking",
    "mcp",
    "account-connection",
    "github"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/nmking-github-connect/SKILL.md",
      "mcpServers": "./mcp.json",
      "interface": {
        "displayName": "GitHub",
        "shortDescription": "GitHub MCP 外掛",
        "longDescription": "NMKING 包裝的 GitHub MCP 外掛，內含真正的 MCP 伺服器宣告、獨立登入引導與操作 Skill。透過 Composio 第三方 MCP：先登入 Composio，再只授權 github。不是 GitHub 官方 MCP；不同服務的帳號和權限需分別確認。本外掛預設透過 Composio 第三方 MCP，以瀏覽器登入 GitHub。GitHub 官方遠端 MCP 的 Codex 設定目前要求 PAT；不把它誤稱為免權杖 OAuth 登入。 安裝不代表已取得使用者授權或所有操作都已驗證；非服務供應商官方外掛。",
        "developerName": "小霸王有限公司 / NMKING",
        "category": "Productivity",
        "capabilities": [
          "MCP",
          "Account connection"
        ],
        "websiteURL": "https://ai.nmking.io/connect#github",
        "logo": "./skills/nmking-github-connect/assets/icon.svg",
        "logoDark": "./skills/nmking-github-connect/assets/icon.svg",
        "composerIcon": "./skills/nmking-github-connect/assets/icon.svg",
        "composerIconDark": "./skills/nmking-github-connect/assets/icon.svg",
        "brandColor": "#181717",
        "defaultPrompt": [
          "完成 GitHub MCP 的登入連線，核對帳號並做唯讀確認，需要授權時讓我確認。"
        ]
      }
    }
  }
}
