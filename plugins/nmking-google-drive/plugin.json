        "category": "Productivity",
        "capabilities": [],
        "websiteURL": "https://ai.nmking.io/connect#google-drive",
        "logo": "./skills/nmking-google-drive-connect/assets/icon.svg",
        "logoDark": "./skills/nmking-google-drive-connect/assets/icon.svg",
        "composerIcon": "./skills/nmking-google-drive-connect/assets/icon.svg",
        "composerIconDark": "./skills/nmking-google-drive-connect/assets/icon.svg",
