{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "nmking-padlet",
  "version": "0.2.0",
  "description": "Independently installable Padlet MCP plugin with bundled server configuration and user-owned onboarding.",
  "author": {
    "name": "小霸王有限公司 / NMKING",
    "email": "nmkingtw@gmail.com",
    "url": "https://ai.nmking.io"
  },
  "homepage": "https://ai.nmking.io/connect#padlet",
  "repository": "https://github.com/youjunjer/nmking-plugins",
  "keywords": [
    "nmking",
    "mcp",
    "account-connection",
    "padlet"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/nmking-padlet-connect/SKILL.md",
      "mcpServers": "./mcp.json",
      "interface": {
        "displayName": "Padlet",
        "shortDescription": "Padlet MCP 外掛",
        "longDescription": "NMKING 包裝的 Padlet MCP 外掛，內含真正的 MCP 伺服器宣告、獨立登入引導與操作 Skill。連接服務供應商官方遠端 MCP，由 Codex 依 OAuth discovery 引導使用者在瀏覽器登入並確認權限。 安裝不代表已取得使用者授權或所有操作都已驗證；非服務供應商官方外掛。",
        "developerName": "小霸王有限公司 / NMKING",
        "category": "Productivity",
        "capabilities": [
          "MCP",
          "Account connection"
        ],
        "websiteURL": "https://ai.nmking.io/connect#padlet",
        "logo": "./skills/nmking-padlet-connect/assets/icon.svg",
        "logoDark": "./skills/nmking-padlet-connect/assets/icon.svg",
        "composerIcon": "./skills/nmking-padlet-connect/assets/icon.svg",
        "composerIconDark": "./skills/nmking-padlet-connect/assets/icon.svg",
        "brandColor": "#D51858",
        "defaultPrompt": [
          "完成 Padlet MCP 的登入連線，核對帳號並做唯讀確認，需要授權時讓我確認。"
        ]
      }
    }
  }
}
